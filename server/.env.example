# Server-side OpenAI credential. Never send this value to the Mac app.
OPENAI_API_KEY=sk-proj-...

# Comma-separated SHA-256 hashes generated by `npm run generate-token`.
RELAY_DEVICE_TOKEN_HASHES=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

HOST=127.0.0.1
PORT=8787

# Set this when the relay is published under a path prefix, e.g.
# https://limingyi.com/whisper-relay. With it set the relay answers on both
# /v1/... and /whisper-relay/v1/..., so it works whether or not the reverse proxy in
# front of it strips the prefix. Leave empty when the relay is served at the root.
RELAY_BASE_PATH=/whisper-relay

# Optional allowlists and safety limits.
ALLOWED_TRANSCRIPTION_MODELS=gpt-realtime-whisper,gpt-4o-transcribe,gpt-4o-mini-transcribe
ALLOWED_POLISH_MODELS=gpt-5.6-terra
MAX_CONNECTIONS_PER_DEVICE=2
MAX_POLISH_REQUESTS_PER_MINUTE=30

# The size limits default to values derived from the app's own 610 s audio buffer;
# override them only with a measured reason.
# MAX_TURN_AUDIO_BYTES=33474560
# MAX_FORWARD_BUFFER_BYTES=8388608

# How often the relay pings the Mac. A client that misses one whole interval is
# terminated, releasing its connection slot and its upstream OpenAI session.
CLIENT_HEARTBEAT_INTERVAL_MS=25000
