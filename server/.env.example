# Server-side OpenAI credential. Never send this value to the Mac app.
OPENAI_API_KEY=sk-proj-...

# Server-side Gemini credential used by the default Live SMART transcription path.
GEMINI_API_KEY=AIza...

# Comma-separated SHA-256 hashes generated by `npm run generate-token`.
RELAY_DEVICE_TOKEN_HASHES=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional public-build enrollment. Leave both unset for a normal user-run relay.
# A systemd deployment can enable them with absolute writable paths; its StateDirectory
# and RuntimeDirectory should own the parent directories.
# RELAY_ENROLLMENT_REGISTRY_FILE=/var/lib/whisper-relay/registry.json
# RELAY_ADMIN_SOCKET=/run/whisper-relay/admin.sock
# After the last legacy token is revoked, RELAY_DEVICE_TOKEN_FILE must contain only the
# literal line "# whisper-relay: intentionally empty legacy allowlist".
# A bare empty/comment-only file remains an error so a truncated allowlist fails safe.
MAX_ENROLLMENT_ATTEMPTS_PER_MINUTE=10
MAX_TRANSCRIPTION_SECONDS_PER_DEVICE_PER_DAY=7200
MAX_TOTAL_TRANSCRIPTION_SECONDS_PER_DAY=43200
MAX_POLISH_REQUESTS_PER_DEVICE_PER_DAY=1000
MAX_TOTAL_POLISH_REQUESTS_PER_DAY=6000

HOST=127.0.0.1
PORT=8787

# Set this when the relay is published under a path prefix, e.g.
# https://limingyi.com/whisper-relay. With it set the relay answers on both
# /v1/... and /whisper-relay/v1/..., so it works whether or not the reverse proxy in
# front of it strips the prefix. Leave empty when the relay is served at the root.
RELAY_BASE_PATH=

# Optional allowlists and safety limits.
ALLOWED_TRANSCRIPTION_MODELS=gemini-3.5-transcribe-live,gpt-live-transcribe,gpt-transcribe
ALLOWED_POLISH_MODELS=gpt-5.6-luna
MAX_CONNECTIONS_PER_DEVICE=5
MAX_POLISH_REQUESTS_PER_MINUTE=30

# The size limits default to values derived from the app's own 610 s audio buffer;
# override them only with a measured reason.
# MAX_TURN_AUDIO_BYTES=33474560
# MAX_FORWARD_BUFFER_BYTES=8388608

# How often the relay pings the Mac. A client that misses one whole interval is
# terminated, releasing its connection slot and its upstream OpenAI session.
CLIENT_HEARTBEAT_INTERVAL_MS=25000
# Continued drain progress renews this watchdog; a completely frozen target is reaped.
BACKPRESSURE_STALL_TIMEOUT_MS=60000
